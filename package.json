{
  "name": "obsidian-s3-sync",
  "version": "0.1.0",
  "description": "一个简单、可靠、基于内容 Hash 的 Obsidian S3 同步插件。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "s3",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.10",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.6",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0"
  }
}
