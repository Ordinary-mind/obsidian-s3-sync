{
  "name": "obsidian-s3-sync",
  "version": "0.1.0",
  "description": "一个简单、可靠、基于内容 Hash 的 Obsidian S3 同步插件。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "generate:unicode": "node scripts/generate-unicode-case-folding.mjs && node scripts/generate-unicode-nfc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:s3-contract": "vitest run --config vitest.minio.config.ts",
    "test:s3-aws": "vitest run --config vitest.aws.config.ts",
    "test:s3-baidu": "vitest run --config vitest.baidu.config.ts",
    "test:s3-minio": "npm run test:s3-contract",
    "test:ci": "npm test && npm run test:types && npm run build && git diff --exit-code -- main.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "s3",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@unicode/unicode-15.1.0": "^1.6.17",
    "ajv": "^8.20.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.6",
    "fast-check": "^4.9.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0"
  }
}
