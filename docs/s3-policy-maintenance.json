{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectionProbeCleanupOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/.obsidian-s3-sync/v1/probes/*"
    },
    {
      "Sid": "ExplicitOldGenerationMaintenance",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/.obsidian-s3-sync/v1/repositories/REPLACE_OLD_REPOSITORY_ID/*"
    }
  ]
}
