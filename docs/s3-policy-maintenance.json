{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListExplicitOldGeneration",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "REPLACE_PREFIX/.obsidian-s3-sync/v1/repositories/REPLACE_OLD_REPOSITORY_ID/*"
          ]
        }
      }
    },
    {
      "Sid": "ExplicitOldGenerationMaintenance",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/REPLACE_PREFIX/.obsidian-s3-sync/v1/repositories/REPLACE_OLD_REPOSITORY_ID/*"
    }
  ]
}
